---
import { portfolioData } from '@/data/portfolio';
import Icon from './Icon.astro'; const { experience } = portfolioData;
--- <section id="experiencia" class="section relative bg-neutral-950" aria-labelledby="experience-title"> <div class="container-custom relative z-10"> <header class="max-w-3xl mx-auto mb-14 lg:mb-20 text-center"> <p data-reveal class="eyebrow mb-5">Trajetória</p> <h2 id="experience-title" data-reveal style="--reveal-delay: 80ms" class="section-title mb-4">Experiência Profissional</h2> <p data-reveal style="--reveal-delay: 140ms" class="section-subtitle mx-auto">Minha trajetória prática em desenvolvimento e pesquisa.</p> </header> <div class="max-w-3xl mx-auto space-y-6"> {experience.map((exp, index) => ( <article data-reveal class="card card-interactive" style={`--reveal-delay: ${index * 100}ms`}> <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-5"> <div> <div class="flex items-center gap-2 text-sm text-neutral-500 dark:text-neutral-400 mb-2"> <Icon name="server" class="w-4 h-4" /> <span>{exp.period}</span> </div> <h3 class="text-clamp-xl font-semibold text-neutral-900 dark:text-neutral-50 mb-1">{exp.role}</h3> <p class="text-clamp-base font-medium text-neutral-700 dark:text-neutral-300">{exp.company}</p> <p class="text-sm text-neutral-500 dark:text-neutral-400 flex items-center gap-1 mt-1"> <Icon name="globe" class="w-3.5 h-3.5" /> {exp.location} </p> </div> </div> <div class="max-w-none mb-6"> <ul class="space-y-2"> {exp.description.map((desc) => ( <li class="flex items-start gap-3 text-clamp-base text-neutral-600 dark:text-neutral-400 leading-relaxed"> <Icon name="check" class="w-5 h-5 text-neutral-400 dark:text-neutral-500 flex-shrink-0 mt-0.5" /> <span>{desc}</span> </li> ))} </ul> </div> <div class="flex flex-wrap gap-2 pt-4 border-t border-neutral-200 dark:border-neutral-800"> {exp.technologies.map((tech) => ( <span class="tag tag-primary">{tech}</span> ))} </div> </article> ))} </div> </div>
</section>