---
import { portfolioData } from '@/data/portfolio';
import { stackIcons } from '@/data/stackIcons';
import Icon from './Icon.astro';
const { projects, github } = portfolioData;
---

<section id="projetos" class="relative border-y border-neutral-900/10 dark:border-neutral-50/10 bg-neutral-950 text-neutral-50 dark:bg-neutral-950 dark:text-neutral-50" aria-labelledby="projects-title">
  <div class="mx-auto w-full max-w-[80rem] px-5 sm:px-8 lg:px-12 py-20 sm:py-24 lg:py-32">
    <div class="flex flex-wrap items-end justify-between gap-6 mb-12 lg:mb-16">
      <div>
        <p data-reveal class="font-mono text-[0.7rem] font-medium uppercase tracking-[0.22em] text-neutral-400 mb-3">05 — Projetos</p>
        <h2 id="projects-title" data-reveal style="--reveal-delay:80ms" class="display-section">Projetos em destaque</h2>
      </div>
      <p data-reveal style="--reveal-delay:140ms" class="max-w-sm text-neutral-400 leading-relaxed">Aplicações completas, do conceito ao funcionamento em ambiente real.</p>
    </div>

    <div class="space-y-14 lg:space-y-20">
      {projects.map((p, i) => (
        <article data-reveal="wipe" style={`--reveal-delay:${i * 70}ms`} class="grid lg:grid-cols-12 gap-6 lg:gap-10 items-stretch">
          <!-- Painel de tecnologias -->
          <div class={`lg:col-span-5 order-2 ${i % 2 === 1 ? 'lg:order-2' : 'lg:order-none'}`}>
            <div class="sheen relative h-full min-h-[16rem] rounded-2xl overflow-hidden border border-neutral-50/15 bg-neutral-900 flex flex-col p-6 sm:p-8">
              <div class="blueprint absolute inset-0" aria-hidden="true"></div>
              <div class="relative flex items-center justify-between gap-4">
                <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-neutral-400">Projeto 0{i + 1} / 0{projects.length}</span>
                <span class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.16em] border border-neutral-50/25 rounded-full px-3.5 py-1.5 text-neutral-300">{p.period}</span>
              </div>
              <p class="relative mt-6 font-mono text-[0.62rem] uppercase tracking-[0.2em] text-neutral-500">{i === 0 ? 'Desktop · Redes · Tempo real' : 'Web · Banco relacional · Deploy'}</p>
              <ul class="relative mt-3 grid grid-cols-2 gap-2">
                {p.technologies.map((t) => (
                  <li class="flex items-center gap-2.5 rounded-xl bg-neutral-50/[0.06] border border-neutral-50/10 px-3 py-2.5">
                    {stackIcons[t] ? (
                      <img
                        src={stackIcons[t]}
                        alt=""
                        aria-hidden="true"
                        width="20"
                        height="20"
                        loading="lazy"
                        decoding="async"
                        class="w-5 h-5 shrink-0 grayscale invert opacity-80"
                      />
                    ) : (
                      <span class="grid place-items-center w-5 h-5 shrink-0 font-display font-extrabold text-[0.6rem] text-neutral-300" aria-hidden="true">·</span>
                    )}
                    <span class="text-[0.8rem] font-semibold text-neutral-200 leading-tight">{t}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Conteúdo -->
          <div class={`lg:col-span-7 order-1 ${i % 2 === 1 ? 'lg:order-1' : 'lg:order-none'} sheen flex flex-col rounded-2xl border border-neutral-50/15 bg-neutral-900/60 p-6 sm:p-8 lg:p-10 transition-all duration-300 hover:-translate-y-1 hover:border-neutral-50/25`}>
            <h3 class="font-display font-extrabold tracking-[-0.02em] leading-none text-3xl sm:text-4xl">{p.name}</h3>
            <p class="mt-3 text-neutral-300 leading-relaxed">{p.description}</p>
            {p.longDescription && (
              <p class="mt-3 text-[0.95rem] text-neutral-400 leading-relaxed">{p.longDescription}</p>
            )}
            <ul class="mt-6 grid sm:grid-cols-2 gap-x-6 gap-y-2.5">
              {p.highlights.map((h) => (
                <li class="flex items-start gap-2.5 text-[0.9rem] text-neutral-300">
                  <Icon name="check" class="w-4 h-4 mt-0.5 shrink-0 text-neutral-500" />
                  <span>{h}</span>
                </li>
              ))}
            </ul>
            <div class="mt-7 pt-6 border-t border-neutral-50/10 flex flex-wrap gap-3">
              {p.github && (
                <a href={p.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-neutral-50 text-neutral-950 font-semibold text-sm px-6 py-3 hover:-translate-y-0.5 transition-transform">
                  Ver código <Icon name="github" class="w-4 h-4" />
                </a>
              )}
              {p.link && (
                <a href={p.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-neutral-50/30 font-semibold text-sm px-6 py-3 hover:bg-neutral-50 hover:text-neutral-950 transition-colors">
                  Abrir ao vivo <Icon name="arrow-right" class="w-4 h-4" />
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div data-reveal class="mt-14 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5 rounded-2xl border border-neutral-50/15 px-6 py-6 sm:px-8">
      <p class="text-lg text-neutral-300">Veja mais projetos e contribuições no GitHub.</p>
      <a href={github} target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0 items-center gap-2 rounded-full border border-neutral-50/30 px-7 py-3.5 text-sm font-semibold hover:bg-neutral-50 hover:text-neutral-950 transition-colors">
        Ver mais no GitHub <Icon name="arrow-right" class="w-4 h-4" />
      </a>
    </div>
  </div>
</section>

<style>
  #projetos .blueprint {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 90% 90% at 50% 40%, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 90% 90% at 50% 40%, black 30%, transparent 75%);
  }
</style>

<script is:inline>
  // Brilho que acompanha o cursor nos painéis (posição com lerp suave;
  // só opacity anima no CSS; o rAF para quando estabiliza).
  (() => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!window.matchMedia('(hover: hover)').matches) return;
    const els = Array.from(document.querySelectorAll('.sheen'));
    if (!els.length) return;
    const pos = new WeakMap();
    let raf = 0;
    function loop() {
      let active = false;
      els.forEach((el) => {
        const p = pos.get(el);
        if (!p) return;
        p.x += (p.tx - p.x) * 0.18;
        p.y += (p.ty - p.y) * 0.18;
        if (Math.abs(p.tx - p.x) > 0.05 || Math.abs(p.ty - p.y) > 0.05) active = true;
        el.style.setProperty('--mx', p.x.toFixed(1) + '%');
        el.style.setProperty('--my', p.y.toFixed(1) + '%');
      });
      raf = active ? requestAnimationFrame(loop) : 0;
    }
    function kick() { if (!raf) raf = requestAnimationFrame(loop); }
    els.forEach((el) => {
      pos.set(el, { x: 50, y: 50, tx: 50, ty: 50 });
      el.addEventListener('mousemove', (e) => {
        const r = el.getBoundingClientRect();
        const p = pos.get(el);
        p.tx = (e.clientX - r.left) / r.width * 100;
        p.ty = (e.clientY - r.top) / r.height * 100;
        kick();
      }, { passive: true });
    });
  })();
</script>
