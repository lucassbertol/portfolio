---
import { portfolioData } from '@/data/portfolio';
import Icon from './Icon.astro'; const { projects } = portfolioData;
--- <section id="projetos" class="section relative bg-neutral-950" aria-labelledby="projects-title"> <div class="container-custom relative z-10"> <header class="max-w-3xl mx-auto mb-14 lg:mb-20 text-center"> <p data-reveal class="eyebrow mb-5">Portfólio</p> <h2 id="projects-title" data-reveal style="--reveal-delay: 80ms" class="section-title mb-4">Projetos em Destaque</h2> <p data-reveal style="--reveal-delay: 140ms" class="section-subtitle mx-auto">Aplicações reais que desenvolvi, do conceito ao deploy.</p> </header> <div class="grid lg:grid-cols-2 gap-6 lg:gap-8"> {projects.map((project, index) => ( <article data-reveal class="card card-interactive group overflow-hidden" style={`--reveal-delay: ${index * 120}ms`}> <div class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-neutral-900/[0.04] dark:from-neutral-50/[0.05] to-transparent pointer-events-none" aria-hidden="true"></div> <div class="relative flex items-start justify-between gap-4 mb-4"> <div> <span class="tag tag-primary mb-3.5">{project.period}</span> <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-50 mb-2">{project.name}</h3> </div> <div class="flex items-center gap-1"> {project.github && ( <a href={project.github} target="_blank" rel="noopener noreferrer" aria-label={`Ver código do ${project.name} no GitHub`} class="p-2.5 rounded-xl text-neutral-400 dark:text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-50 hover:bg-neutral-900/[0.05] dark:hover:bg-neutral-50/[0.08] transition-all hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-900 dark:focus-visible:ring-neutral-100" > <Icon name="github" class="w-5 h-5" /> </a> )} </div> </div> <p class="text-clamp-base text-neutral-600 dark:text-neutral-400 mb-5 leading-relaxed">{project.description}</p> {project.longDescription && ( <details class="mb-5 group"> <summary class="flex items-center gap-2 text-sm font-medium text-neutral-700 dark:text-neutral-300 cursor-pointer list-none"> <Icon name="arrow-right" class="w-4 h-4 text-neutral-400 dark:text-neutral-500 transition-transform group-open:rotate-90" /> Ver detalhes técnicos </summary> <div class="mt-3 pt-3 border-t border-neutral-200 dark:border-neutral-800 text-clamp-sm text-neutral-600 dark:text-neutral-400 leading-relaxed"> {project.longDescription} </div> </details> )} <div class="flex flex-wrap gap-2 mb-5"> {project.technologies.map((tech) => ( <span class="tag">{tech}</span> ))} </div> <div class="space-y-3 pt-4 border-t border-neutral-200 dark:border-neutral-800"> {project.highlights.map((highlight) => ( <div class="flex items-start gap-3 text-clamp-sm text-neutral-600 dark:text-neutral-400"> <Icon name="check" class="w-4 h-4 text-neutral-400 dark:text-neutral-500 flex-shrink-0 mt-0.5" /> <span>{highlight}</span> </div> ))} </div> </article> ))} </div> <!-- CTA for more projects --> <div data-reveal class="text-center mt-14"> <a href={portfolioData.github} target="_blank" rel="noopener noreferrer" class="btn-secondary group" > Ver mais no GitHub <Icon name="arrow-right" class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" /> </a> </div> </div>
</section>