---
import { portfolioData } from '@/data/portfolio';
import Icon from './Icon.astro';
const { email, socialLinks } = portfolioData;
---

<section id="contato" class="relative" aria-labelledby="contact-title">
  <div class="wrap py-20 sm:py-24 lg:py-32">
    <div class="grid lg:grid-cols-12 gap-8">
      <div class="lg:col-span-6">
        <p data-reveal class="mono-label mb-3">06 — Contato</p>
        <h2 id="contact-title" data-reveal style="--reveal-delay:80ms" class="display-section">Entre em contato</h2>
        <p data-reveal style="--reveal-delay:140ms" class="mt-5 max-w-md leading-[1.7] text-neutral-600 dark:text-neutral-400">
          Estou disponível para oportunidades de trabalho, projetos freelance e colaborações. Envie uma mensagem com o contexto e o prazo — respondo em breve.
        </p>

        <div data-reveal style="--reveal-delay:200ms" class="mt-8 border border-neutral-900/15 dark:border-neutral-50/15 rounded-2xl p-6 sm:p-7 bg-white/50 dark:bg-neutral-900/40">
          <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <span class="mono-label">Email</span>
            <span class="mono-label">Clique para copiar</span>
          </div>
          <button type="button" data-copy-email={email} class="w-full text-left group border-t border-b border-dashed border-neutral-900/25 dark:border-neutral-50/25 py-4 hover:pl-2 transition-all" aria-label="Copiar endereço de email">
            <span class="mt-1 flex items-center justify-between gap-3 font-display font-extrabold text-lg sm:text-xl tracking-[-0.01em] break-all">{email} <span class="shrink-0 font-mono text-[0.65rem] uppercase tracking-[0.16em] border border-current rounded-full px-3 py-1.5 group-hover:bg-neutral-900 group-hover:text-neutral-50 dark:group-hover:bg-neutral-50 dark:group-hover:text-neutral-900 transition-colors">Copiar</span></span>
          </button>
          <ul class="mt-4 grid sm:grid-cols-3 gap-2">
            {socialLinks.filter((s) => s.icon !== 'email').map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.name} class="flex items-center gap-3 border border-neutral-900/15 dark:border-neutral-50/15 rounded-xl px-4 py-3 text-sm font-semibold hover:bg-neutral-900 hover:text-neutral-50 dark:hover:bg-neutral-50 dark:hover:text-neutral-900 transition-colors">
                  <Icon name={s.icon} class="w-5 h-5 shrink-0 opacity-70" />
                  <span>{s.name}</span>
                  <Icon name="arrow-right" class="w-4 h-4 ml-auto opacity-40" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="lg:col-span-6">
        <div data-reveal="lateral-r" style="--reveal-delay:160ms" class="border border-neutral-900/15 dark:border-neutral-50/15 rounded-2xl p-6 sm:p-8 bg-white/60 dark:bg-neutral-900/50 backdrop-blur">
          <div class="flex items-center justify-between mb-6">
            <h3 class="font-display font-extrabold uppercase tracking-[-0.02em] text-xl">Enviar mensagem</h3>
          </div>
          <form id="contact-form" action="https://formspree.io/f/your-form-id" method="POST" class="space-y-5" novalidate>
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="label">Nome *</label>
                <input type="text" id="name" name="name" class="input" placeholder="Seu nome" required autocomplete="name" />
              </div>
              <div>
                <label for="email" class="label">Email *</label>
                <input type="email" id="email" name="email" class="input" placeholder="voce@exemplo.com" required autocomplete="email" />
              </div>
            </div>
            <div>
              <label for="subject" class="label">Assunto *</label>
              <select id="subject" name="subject" class="input" required>
                <option value="">Selecione um assunto</option>
                <option value="oportunidade">Oportunidade de trabalho</option>
                <option value="freelance">Projeto freelance</option>
                <option value="colaboracao">Colaboração</option>
                <option value="outro">Outro</option>
              </select>
            </div>
            <div>
              <label for="message" class="label">Mensagem *</label>
              <textarea id="message" name="message" rows="5" class="input resize-y min-h-[120px]" placeholder="Descreva a oportunidade ou o projeto..." required></textarea>
            </div>
            <button type="submit" class="btn-primary w-full" id="submit-btn">
              <span class="btn-text">Enviar mensagem</span>
              <span class="btn-loading hidden">Enviando...</span>
              <Icon name="arrow-right" class="w-4 h-4" />
            </button>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 text-center">Ao enviar, você concorda com o processamento dos dados conforme a LGPD.</p>
          </form>
        </div>
      </div>
    </div>
  </div>

  <div id="toast" class="hidden fixed top-6 left-1/2 -translate-x-1/2 z-[115] max-w-[calc(100vw-3rem)]" role="alert" aria-live="polite">
    <div class="flex items-center gap-3 pl-4 pr-5 py-3 rounded-2xl bg-neutral-900 text-neutral-50 dark:bg-neutral-50 dark:text-neutral-900 shadow-2xl">
      <span id="toast-icon" class="flex-shrink-0 w-8 h-8 rounded-full border border-current flex items-center justify-center" aria-hidden="true">✓</span>
      <span id="toast-message" class="text-sm font-medium"></span>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('submit-btn');
    const toast = document.getElementById('toast');
    const toastMessage = document.getElementById('toast-message');
    function showToast(msg) {
      if (!toast || !toastMessage) return;
      toastMessage.textContent = msg;
      toast.classList.remove('hidden');
      toast.classList.add('toast-show');
      setTimeout(() => toast.classList.add('hidden'), 5000);
    }
    if (form) form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries());
      if (!data.name || !data.email || !data.subject || !data.message) { showToast('Por favor, preencha todos os campos.'); return; }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(data.email))) { showToast('Por favor, informe um email válido.'); return; }
      if (submitBtn) submitBtn.disabled = true;
      try {
        const r = await fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(data) });
        if (!r.ok) throw new Error('fail');
        showToast('Mensagem enviada. Retornarei em breve.');
        form.reset();
      } catch (err) { showToast('Erro ao enviar. Tente pelo email direto.'); }
      finally { if (submitBtn) submitBtn.disabled = false; }
    });
    if (toast) toast.addEventListener('click', () => toast.classList.add('hidden'));
    function copyText(t, done) {
      if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(t).then(() => done(true), () => done(false));
      else {
        const ta = document.createElement('textarea');
        ta.value = t; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        let ok = false;
        try { ok = document.execCommand('copy'); } catch (e) {}
        document.body.removeChild(ta); done(ok);
      }
    }
    document.querySelectorAll('[data-copy-email]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const addr = btn.getAttribute('data-copy-email');
        if (addr) copyText(addr, (ok) => showToast(ok ? 'Email copiado: ' + addr : 'Anote: ' + addr));
      });
    });
  })();
</script>
