---
import { portfolioData } from '@/data/portfolio';
import Icon from './Icon.astro'; const { skills } = portfolioData; const categoryIcons: Record<string, string> = { 'Backend': 'server', 'Frontend': 'code', 'Ferramentas & DevOps': 'database', 'Testes & Qualidade': 'test', 'Dados & Análise': 'cloud', 'IA & Cloud': 'ai',
};
--- <section id="habilidades" class="section relative bg-neutral-950" aria-labelledby="skills-title"> <div class="container-custom relative z-10"> <header class="max-w-3xl mx-auto mb-14 lg:mb-20 text-center"> <p data-reveal class="eyebrow mb-5">Stack</p> <h2 id="skills-title" data-reveal style="--reveal-delay: 80ms" class="section-title mb-4">Habilidades Técnicas</h2> <p data-reveal style="--reveal-delay: 140ms" class="section-subtitle mx-auto">Tecnologias e ferramentas que domino, organizadas por categoria.</p> </header> <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6"> {skills.map((category, index) => ( <article data-reveal class="card card-interactive group" style={`--reveal-delay: ${index * 90}ms`}> <div class="flex items-center gap-3.5 mb-5"> <div class="w-12 h-12 rounded-2xl bg-neutral-900/[0.05] dark:bg-neutral-50/[0.07] border border-neutral-900/[0.06] dark:border-neutral-50/[0.08] flex items-center justify-center flex-shrink-0 transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-3"> <Icon name={categoryIcons[category.name] || 'code'} class="w-5 h-5 text-neutral-900 dark:text-neutral-50" /> </div> <h3 class="font-semibold tracking-tight text-neutral-900 dark:text-neutral-50">{category.name}</h3> </div> <div class="flex flex-wrap gap-2"> {category.skills.map((skill) => ( <span class="tag"> {skill} </span> ))} </div> </article> ))} </div> </div>
</section>