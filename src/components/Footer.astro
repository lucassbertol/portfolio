---
import { portfolioData } from '@/data/portfolio';
import Icon from './Icon.astro';
const { name, email, socialLinks } = portfolioData;
const currentYear = new Date().getFullYear();
---

<div class="bg-neutral-900 text-neutral-50 dark:bg-neutral-950 dark:text-neutral-50 border-t-2 border-neutral-900 dark:border-neutral-50/20">
  <div data-reveal class="mx-auto w-full max-w-[80rem] px-5 sm:px-8 lg:px-12 pt-12 pb-8">
    <!-- Colofão gigante -->
    <a href="#inicio" class="block group" aria-label="Voltar ao topo">
      <p class="font-mono text-[0.65rem] uppercase tracking-[0.22em] text-neutral-400 mb-2">Voltar ao início ↑</p>
      <p class="font-display font-extrabold uppercase leading-[0.95] tracking-[-0.03em] text-[clamp(2rem,6vw,4.5rem)]">Vamos trabalhar juntos?</p>
    </a>

    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-8 border-t border-neutral-50/15 pt-8">
      <div>
        <p class="font-mono text-[0.62rem] uppercase tracking-[0.2em] text-neutral-400 mb-3">Expediente</p>
        <p class="font-display font-extrabold uppercase">{name}</p>
      </div>
      <nav aria-label="Navegação de rodapé">
        <p class="font-mono text-[0.62rem] uppercase tracking-[0.2em] text-neutral-400 mb-3">Capítulos</p>
        <ul class="space-y-2 text-sm">
          {[['#sobre','02 Perfil'],['#habilidades','03 Stack'],['#experiencia','04 Campo'],['#projetos','05 Casos'],['#contato','06 Sinal']].map(([h,t]) => (
            <li><a href={h} class="text-neutral-300 hover:text-white hover:translate-x-1 transition-[transform,color]">{t}</a></li>
          ))}
        </ul>
      </nav>
      <div>
        <p class="font-mono text-[0.62rem] uppercase tracking-[0.2em] text-neutral-400 mb-3">Direto</p>
        <address class="not-italic space-y-2 text-sm text-neutral-300">
          <a href={`mailto:${email}`} class="hover:text-white transition-colors whitespace-nowrap">{email}</a>
          <p class="text-neutral-400">Santa Maria, RS — Brasil</p>
        </address>
      </div>
      <div>
        <p class="font-mono text-[0.62rem] uppercase tracking-[0.2em] text-neutral-400 mb-3">Arquivo</p>
        <div class="flex flex-wrap gap-2">
          {socialLinks.map((s) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.ariaLabel} title={s.name} class="p-2.5 rounded-xl border border-neutral-50/20 text-neutral-300 hover:bg-neutral-50 hover:text-neutral-950 transition-colors">
              <Icon name={s.icon} class="w-4 h-4" />
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-neutral-50/15 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-neutral-500">© {currentYear} {name}</p>
      <div class="flex items-center gap-4 font-mono text-[0.62rem] uppercase tracking-[0.16em]">
        <a href="#inicio" class="text-neutral-400 hover:text-white transition-colors">Topo</a>
        <a href="https://github.com/lucassbertol/portfolio" target="_blank" rel="noopener noreferrer" class="text-neutral-400 hover:text-white transition-colors inline-flex items-center gap-1"><Icon name="github" class="w-3.5 h-3.5" /> Fonte</a>
      </div>
    </div>
  </div>
</div>
