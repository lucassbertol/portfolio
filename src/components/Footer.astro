---
import { portfolioData } from '@/data/portfolio';
import Icon from './Icon.astro'; const { name, email, github, linkedin, website, socialLinks } = portfolioData;
const currentYear = new Date().getFullYear();
--- <footer class="bg-white/70 dark:bg-neutral-950/60 backdrop-blur-2xl backdrop-saturate-150 border-t border-neutral-900/[0.06] dark:border-neutral-50/[0.06]" role="contentinfo"> <div class="container-custom py-10 lg:py-14"> <div class="grid lg:grid-cols-3 gap-8 lg:gap-12"> <!-- Brand & Bio --> <div class="lg:col-span-1"> <a href="#inicio" class="inline-block mb-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-900 dark:focus-visible:ring-neutral-50 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-50 dark:focus-visible:ring-offset-neutral-900 rounded-md"> <span class="text-clamp-xl font-bold gradient-text">{name}</span> </a> <p class="text-clamp-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-6 max-w-xs"> Desenvolvedor Fullstack apaixonado por construir soluções elegantes e funcionais. Busco oportunidades para crescer e contribuir com times de alta performance. </p> <div class="flex items-center gap-4"> {socialLinks.slice(0, 3).map((social) => ( <a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={social.ariaLabel} class="p-2 rounded-lg text-neutral-400 dark:text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-50 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-900 dark:focus-visible:ring-neutral-50" > <Icon name={social.icon} class="w-5 h-5" /> </a> ))} </div> </div> <!-- Quick Links --> <nav class="lg:col-span-1" aria-label="Navegação rápida"> <h3 class="text-sm font-semibold text-neutral-900 dark:text-neutral-50 uppercase tracking-wider mb-4">Navegação</h3> <ul class="space-y-3"> <li><a href="#sobre" class="footer-link">Sobre Mim</a></li> <li><a href="#habilidades" class="footer-link">Habilidades</a></li> <li><a href="#experiencia" class="footer-link">Experiência</a></li> <li><a href="#projetos" class="footer-link">Projetos</a></li> <li><a href="#contato" class="footer-link">Contato</a></li> </ul> </nav> <!-- Contact & Legal --> <div class="lg:col-span-1"> <h3 class="text-sm font-semibold text-neutral-900 dark:text-neutral-50 uppercase tracking-wider mb-4">Contato Direto</h3> <address class="not-italic space-y-3 text-clamp-sm text-neutral-600 dark:text-neutral-400"> <a href={`mailto:${email}`} class="footer-link flex items-center gap-2"> <Icon name="email" class="w-4 h-4" /> <span>{email}</span> </a>  <div class="flex items-center gap-2"> <Icon name="globe" class="w-4 h-4" /> <span>Santa Maria, RS, Brasil</span> </div> </address> <div class="mt-8 pt-6 border-t border-neutral-200 dark:border-neutral-800"> <p class="text-xs text-neutral-500 dark:text-neutral-400 text-center"> &copy; {currentYear} {name}. Todos os direitos reservados. </p> <p class="text-xs text-neutral-500 dark:text-neutral-400 text-center mt-1"> Construído com <span class="text-red-500">♥</span> </p> </div> </div> </div> <!-- Bottom bar --> <div class="mt-8 pt-8 border-t border-neutral-200 dark:border-neutral-800"> <div class="flex flex-col sm:flex-row items-center justify-between gap-4"> <p class="text-xs text-neutral-500 dark:text-neutral-400"> Feito com foco em performance, acessibilidade e boas práticas web. </p> <div class="flex items-center gap-4"> <a href="#inicio" class="footer-link text-xs">Voltar ao topo</a> <a href={github} target="_blank" rel="noopener noreferrer" class="footer-link text-xs flex items-center gap-1"> <Icon name="github" class="w-3.5 h-3.5" /> Código Fonte </a> </div> </div> </div> </div>
</footer> <style> .footer-link { @apply text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-50 transition-colors; }
</style>