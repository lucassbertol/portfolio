---
import { portfolioData } from '@/data/portfolio';
import Icon from './Icon.astro';
const { email } = portfolioData;
---

<div class="wrap">
  <div class="flex items-center justify-between gap-4 h-16 lg:h-[72px]">
    <!-- Marca editorial -->
    <a href="#inicio" class="flex items-baseline gap-2 min-w-0" aria-label="Voltar ao início — Lucas Bertol">
      <span class="font-display font-black tracking-[-0.04em] text-lg leading-none uppercase">Bertol<span aria-hidden="true">®</span></span>
      <span class="hidden md:inline font-mono text-[0.62rem] uppercase tracking-[0.22em] text-neutral-500 dark:text-neutral-400 border border-neutral-900/15 dark:border-neutral-50/15 rounded-full px-2.5 py-1">Desenvolvedor Fullstack</span>
    </a>

    <!-- Meta central (revista) -->
    <p class="hidden lg:block font-mono text-[0.65rem] uppercase tracking-[0.22em] text-neutral-500 dark:text-neutral-400">
      Portfólio · 2026 · <span id="masthead-clock" class="tabular-nums">00:00</span>
    </p>

    <div class="flex items-center gap-2 sm:gap-3">
      <a href={`mailto:${email}`} class="hidden sm:inline-flex btn-secondary !px-5 !py-2.5 !text-[0.8rem]">
        Contato
        <Icon name="arrow-right" class="w-4 h-4" />
      </a>
      <button
        id="index-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="index-overlay"
        class="inline-flex items-center gap-2.5 rounded-full border border-neutral-900/20 dark:border-neutral-50/20 px-5 py-2.5 font-mono text-[0.75rem] font-bold uppercase tracking-[0.16em] hover:bg-neutral-900 hover:text-neutral-50 dark:hover:bg-neutral-50 dark:hover:text-neutral-900 transition-colors"
      >
        <span id="index-toggle-label">Índice</span>
        <span class="flex flex-col gap-[5px]" aria-hidden="true">
          <span class="block h-[1.5px] w-5 bg-current"></span>
          <span class="block h-[1.5px] w-5 bg-current"></span>
        </span>
      </button>
    </div>
  </div>
</div>

<!-- Overlay: índice gigante numerado -->
<div id="index-overlay" class="fixed inset-0 z-[105]" role="dialog" aria-modal="true" aria-label="Índice do portfólio">
  <div class="absolute inset-0 bg-neutral-950/60 backdrop-blur-sm" data-close-index aria-hidden="true"></div>
  <div class="index-panel absolute inset-x-0 top-0 max-h-svh overflow-y-auto overscroll-contain bg-neutral-50 dark:bg-neutral-950 border-b border-neutral-900/10 dark:border-neutral-50/10">
    <div class="wrap py-8 sm:py-12">
      <div class="flex items-center justify-between mb-8">
        <p class="mono-label">Índice — 06 seções</p>
        <button type="button" data-close-index class="mono-label link-sweep" aria-label="Fechar índice">Fechar ✕</button>
      </div>
      <nav aria-label="Índice completo">
        <ol class="divide-y divide-neutral-900/10 dark:divide-neutral-50/10 border-y border-neutral-900/10 dark:border-neutral-50/10">
          {[
            { n: '01', href: '#inicio', t: 'Início', d: 'Apresentação' },
            { n: '02', href: '#sobre', t: 'Sobre', d: 'Formação e certificações' },
            { n: '03', href: '#habilidades', t: 'Habilidades', d: 'Tecnologias por categoria' },
            { n: '04', href: '#experiencia', t: 'Experiência', d: 'NCC-UFSM' },
            { n: '05', href: '#projetos', t: 'Projetos', d: 'NetCommander · uniMarket' },
            { n: '06', href: '#contato', t: 'Contato', d: 'Email e mensagem' },
          ].map((item) => (
            <li>
              <a href={item.href} data-close-index class="group grid grid-cols-[3.2rem_1fr_auto] sm:grid-cols-[5rem_1fr_1fr_auto] items-center gap-3 sm:gap-6 py-4 sm:py-5 hover:translate-x-1 transition-transform duration-300">
                <span class="font-mono text-xs font-bold text-neutral-400 dark:text-neutral-500">{item.n}</span>
                <span class="font-display font-extrabold uppercase tracking-[-0.02em] leading-none text-2xl sm:text-4xl">{item.t}</span>
                <span class="hidden sm:block font-mono text-[0.7rem] uppercase tracking-[0.14em] text-neutral-500 dark:text-neutral-400">{item.d}</span>
                <Icon name="arrow-right" class="w-5 h-5 -translate-x-2 opacity-0 group-hover:translate-x-0 group-hover:opacity-100 transition-[transform,opacity] duration-300" />
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const toggle = document.getElementById('index-toggle');
    const label = document.getElementById('index-toggle-label');
    const overlay = document.getElementById('index-overlay');
    const clock = document.getElementById('masthead-clock');
    function setOpen(open) {
      if (!overlay || !toggle) return;
      overlay.classList.toggle('is-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
      toggle.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Fechar' : 'Índice';
      if (open) {
        const first = overlay.querySelector('a');
        if (first) first.focus();
      }
    }
    if (toggle && overlay) {
      toggle.addEventListener('click', () => {
        setOpen(!overlay.classList.contains('is-open'));
      });
      overlay.querySelectorAll('[data-close-index]').forEach((el) => {
        el.addEventListener('click', () => setOpen(false));
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && overlay.classList.contains('is-open')) setOpen(false);
      });
    }
    // Relógio da banca (só decorativo, hora local)
    function tick() {
      if (!clock) return;
      const d = new Date();
      clock.textContent = String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
    }
    tick();
    setInterval(tick, 30000);
    // Smooth scroll com offset do masthead
    document.querySelectorAll('a[href^="#"]').forEach(function(anchor) {
      anchor.addEventListener('click', function(e) {
        const id = anchor.getAttribute('href');
        if (!id || id === '#') return;
        const target = document.querySelector(id);
        if (target) {
          e.preventDefault();
          const h = document.getElementById('site-header');
          const off = h ? h.offsetHeight : 0;
          window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - off, behavior: 'smooth' });
        }
      });
    });
  })();
</script>
