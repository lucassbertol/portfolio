---
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'profile';
}

const { title, description, image, type = 'website' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : new URL('/og-image.png', Astro.site).href;
---

<!doctype html>
<html lang="pt-BR" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Lucas Bertol - Portfolio" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Additional SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#171717" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Lucas Salvini Bertol",
      "url": "https://lucasbertol.dev.br",
      "image": ogImage,
      "sameAs": [
        "https://github.com/lucassbertol",
        "https://www.linkedin.com/in/lucas-bertol-85410934a"
      ],
      "jobTitle": "Desenvolvedor Fullstack",
      "worksFor": {
        "@type": "Organization",
        "name": "NCC - Núcleo de Ciência da Computação"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Santa Maria",
        "addressRegion": "RS",
        "addressCountry": "BR"
      },
      "email": "mailto:lucassalvinibertol@gmail.com",
      "knowsAbout": [
        "Python", "Django", "PHP", "JavaScript", "React", "Node.js",
        "TypeScript", "HTML5", "CSS3", "Git", "Docker", "Pytest",
        "Power BI", "MySQL", "PostgreSQL", "Testes de Software",
        "Análise de Dados", "Inteligência Artificial", "Cloud Computing"
      ],
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "Universidade Federal de Santa Maria"
      }
    })} />

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://github.com" />
    <link rel="dns-prefetch" href="https://linkedin.com" />

    <!-- Fonts: Inter + JetBrains Mono (self-hosted via Google Fonts) -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body class="h-full flex flex-col grain">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-neutral-900 focus:text-neutral-50 focus:rounded-full text-sm font-medium">
      Pular para o conteúdo principal
    </a>

    <div id="scroll-progress" class="fixed top-0 left-0 h-[2px] w-full origin-left scale-x-0 bg-neutral-900 dark:bg-neutral-100 z-50" aria-hidden="true"></div>

    <header id="site-header" class="sticky top-0 z-40 glass border-b border-neutral-900/[0.06] dark:border-neutral-50/[0.06] transition-all duration-300">
      <slot name="header" />
    </header>

    <main id="main-content" class="flex-1" role="main">
      <slot />
    </main>

    <footer class="border-t border-neutral-200 dark:border-neutral-800">
      <slot name="footer" />
    </footer>

    <!-- Theme toggle and scroll restoration script -->
    <script is:inline>
      (() => {
        document.documentElement.classList.add('dark');

        if ('scrollRestoration' in history) {
          history.scrollRestoration = 'manual';
        }
        window.addEventListener('beforeunload', () => {
          try { sessionStorage.setItem('scrollPos', window.scrollY.toString()); } catch (e) {}
        });
        window.addEventListener('load', () => {
          try {
            const pos = sessionStorage.getItem('scrollPos');
            if (pos) {
              window.scrollTo(0, parseInt(pos, 10));
              sessionStorage.removeItem('scrollPos');
            }
          } catch (e) {}
        });

        const progress = document.getElementById('scroll-progress');
        const header = document.getElementById('site-header');
        let ticking = false;
        function onScroll() {
          if (!ticking) {
            window.requestAnimationFrame(function() {
              const max = document.documentElement.scrollHeight - window.innerHeight;
              const p = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
              if (progress) progress.style.transform = 'scaleX(' + p + ')';
              if (header) {
                if (window.scrollY > 24) header.classList.add('is-scrolled');
                else header.classList.remove('is-scrolled');
              }
              ticking = false;
            });
            ticking = true;
          }
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();
    </script>
    <style>
      #site-header.is-scrolled {
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.05), 0 12px 32px -16px rgb(0 0 0 / 0.18);
      }
    </style>
  </body>
</html>